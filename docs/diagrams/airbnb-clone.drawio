rce="c26" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c190" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.218;exitDx=0;exitDy=0;entryX=0;entryY=0.431;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c117"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c191" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.698;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c146"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c192" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9736;exitDx=0;exitDy=0;entryX=0;entryY=0.397;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c161"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c193" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.0875;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c194" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.318;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c195" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="c99" target="c94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c196" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.599;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c197" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c117" target="c146"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c198" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.621;exitDx=0;exitDy=0;entryX=0;entryY=0.274;entryDx=0;entryDy=0;" edge="1" parent="1" source="c117" target="c172"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="500"/><mxPoint x="1280" y="730"/></Array></mxGeometry></mxCell><mxCell id="c199" value="SET NULL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=10;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.476;exitDx=0;exitDy=0;entryX=0;entryY=0.822;entryDx=0;entryDy=0;" edge="1" parent="1" source="c161" target="c172"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="910"/><mxPoint x="1280" y="810"/></Array></mxGeometry></mxCell><mxCell id="c200" value="&lt;b&gt;Constraints and indexes&lt;/b&gt; (SQLite with PRAGMA foreign_keys=ON)&lt;br&gt;• listings: CHECK base_price &amp;gt; 0 · CHECK min_nights ≥ 1 AND max_nights ≥ min_nights · CHECK discounts BETWEEN 0 AND 90 · INDEX city, category, host_id&lt;br&gt;• bookings: CHECK check_out &amp;gt; check_in · CHECK status IN ('confirmed','cancelled') · INDEX (listing_id, check_in, check_out), guest_id&lt;br&gt;• blocked_dates: CHECK end_date &amp;gt; start_date&lt;br&gt;• reviews: UNIQUE booking_id (one review per stay) · CHECK rating BETWEEN 1 AND 5&lt;br&gt;• message_templates: CHECK trigger IN ('on_confirm','day_before_checkin','on_checkout')&lt;br&gt;• users.email UNIQUE · amenities.name UNIQUE&lt;br&gt;• Composite PKs on listing_amenities and wishlist_items&lt;br&gt;• Every FK is ON DELETE CASCADE except messages.template_id (SET NULL)&lt;br&gt;• Money is whole rupees (INTEGER). Bookings store a price snapshot. Ratings are not stored: AVG(rating) per listing is computed in a subquery." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="490" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 · Backend modules"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Backend modules (backend/app)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="Arrows are Python imports (A → B means A uses B). A request goes main → router → deps / rules / schemas → models → db → SQLite." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;tests/test_api.py&lt;/b&gt;&lt;br&gt;13 pytest tests · TestClient(app)&lt;br&gt;temporary DATA_DIR&lt;br&gt;fresh seed() before each test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="340" height="120" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;main.py&lt;/b&gt;&lt;br&gt;FastAPI app · CORSMiddleware&lt;br&gt;include_router(×4, prefix="/api")&lt;br&gt;mount /uploads · GET /health · db.sync_schema()&lt;br&gt;__main__: seed_if_empty() + uvicorn' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="360" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;seed.py&lt;/b&gt;&lt;br&gt;11 users · 41 listings · 20 amenities&lt;br&gt;bookings, reviews, blocks, wishlist&lt;br&gt;random.Random(42) · imports rules, models, db" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="320" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="routers/  (APIRouter, mounted under /api)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f6fbf4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1160" height="256" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;bookings.py&lt;/b&gt;  /bookings&lt;br&gt;POST  /&lt;br&gt;GET  /me&lt;br&gt;GET  /inbox?role=guest|host&lt;br&gt;GET  /{id}&lt;br&gt;POST  /{id}/cancel&lt;br&gt;GET  /{id}/messages&lt;br&gt;POST  /{id}/review&lt;br&gt;&lt;i&gt;_booking_lock = threading.Lock()&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;" vertex="1" parent="c9"><mxGeometry x="20" y="36" width="250" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;host.py&lt;/b&gt;&lt;br&gt;GET  /host/listings&lt;br&gt;GET  /host/bookings&lt;br&gt;GET · POST  /listings/{id}/blocks&lt;br&gt;DELETE  /blocks/{id}&lt;br&gt;GET · POST  /listings/{id}/templates&lt;br&gt;PUT · DELETE  /templates/{id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;" vertex="1" parent="c9"><mxGeometry x="310" y="36" width="250" height="170" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;listings.py&lt;/b&gt;  /listings&lt;br&gt;GET  /  (search, paginated)&lt;br&gt;GET  /{id}&lt;br&gt;GET  /{id}/availability&lt;br&gt;GET  /{id}/quote&lt;br&gt;GET  /{id}/reviews&lt;br&gt;POST  /&lt;br&gt;PUT · DELETE  /{id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;" vertex="1" parent="c9"><mxGeometry x="600" y="36" width="250" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;users.py&lt;/b&gt;&lt;br&gt;GET  /users&lt;br&gt;GET  /me&lt;br&gt;GET  /amenities&lt;br&gt;GET  /wishlist · /wishlist/ids&lt;br&gt;POST · DELETE  /wishlist/{listing_id}&lt;br&gt;POST  /uploads  (≤ 5 MB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;" vertex="1" parent="c9"><mxGeometry x="890" y="36" width="250" height="170" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;exitX=0;exitY=0.55;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Dashed = shared helpers: host.py uses booking_query() / to_out() from bookings.py and card_query() / to_card() from listings.py; users.py uses card_query() / to_card()." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;fontStyle=0;" vertex="1" parent="c9"><mxGeometry x="20" y="214" width="1120" height="30" as="geometry"/></mxCell><mxCell id="c18" value="include_router" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;deps.py&lt;/b&gt;  (mocked auth)&lt;br&gt;DB = Annotated[Session, Depends(get_db)]&lt;br&gt;CurrentUser: X-User-Id → User, else 401&lt;br&gt;get_listing() → 404&lt;br&gt;owned_listing() → 403" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="340" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;rules.py&lt;/b&gt;  (pure business logic)&lt;br&gt;nightly_rate() · quote() · price_snapshot()&lt;br&gt;unavailable_exists() · is_available()&lt;br&gt;stay_error()&lt;br&gt;render_messages() · _send_at()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="440" y="580" width="360" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;schemas.py&lt;/b&gt;  (Pydantic 2)&lt;br&gt;ListingIn · ListingCard · ListingDetail · Page&lt;br&gt;BookingIn · BookingOut · Quote · Range&lt;br&gt;BlockIn/Out · TemplateIn/Out · ReviewIn/Out&lt;br&gt;UserOut · UserDetail · Thread · MessageOut" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="340" height="110" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.1466;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8534;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;models.py&lt;/b&gt;  (SQLAlchemy 2, Mapped[...])&lt;br&gt;User · Listing · ListingPhoto · Amenity · listing_amenities · Booking&lt;br&gt;BlockedDate · Review · WishlistItem · MessageTemplate · Message" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="750" width="640" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.681;exitY=1;exitDx=0;exitDy=0;entryX=0.828;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="790"/></Array></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;db.py&lt;/b&gt;&lt;br&gt;engine: sqlite:///DATA_DIR/airbnb.db (check_same_thread=False) · PRAGMA foreign_keys=ON&lt;br&gt;SessionLocal · Base · get_db() · sync_schema() adds missing tables and columns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;vertic