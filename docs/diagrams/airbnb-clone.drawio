;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="A booking for 10 → 13 Nov covers the nights of 10, 11 and 12. The guest leaves on the 13th, so the 13th is free for the next check-in." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="10 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="128" as="sourcePoint"/><mxPoint x="300" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="11 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="128" as="sourcePoint"/><mxPoint x="400" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="12 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="128" as="sourcePoint"/><mxPoint x="500" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="13 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="128" as="sourcePoint"/><mxPoint x="600" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="14 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="128" as="sourcePoint"/><mxPoint x="700" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="15 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="128" as="sourcePoint"/><mxPoint x="800" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="16 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="128" as="sourcePoint"/><mxPoint x="900" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="17 Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="80" height="24" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=none;html=1;strokeColor=#cccccc;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="128" as="sourcePoint"/><mxPoint x="1000" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="128" as="sourcePoint"/><mxPoint x="600" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="13 Nov: A's checkout = B's check-in" style="text;html=1;align=center;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="510" y="474" width="180" height="34" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Existing booking A&lt;/b&gt;&lt;br&gt;status = confirmed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="50" as="geometry"/></mxCell><mxCell id="c23" value="nights 10, 11, 12" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="302" y="156" width="296" height="38" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Request B: 13 → 15&lt;/b&gt;&lt;br&gt;overlap? 13 &amp;lt; 13 is false" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="50" as="geometry"/></mxCell><mxCell id="c25" value="allowed (201)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="602" y="236" width="196" height="38" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Request C: 12 → 14&lt;/b&gt;&lt;br&gt;12 &amp;lt; 13 and 14 &amp;gt; 10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="240" height="50" as="geometry"/></mxCell><mxCell id="c27" value="rejected (409)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="502" y="316" width="196" height="38" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Host block: 15 → 17&lt;/b&gt;&lt;br&gt;blocked_dates row" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="240" height="50" as="geometry"/></mxCell><mxCell id="c29" value="blocked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fillColor=#e6e6e6;" vertex="1" parent="1"><mxGeometry x="802" y="396" width="196" height="38" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;overlap(a, b)  ⇔  a.check_in &amp;lt; b.check_out  AND  a.check_out &amp;gt; b.check_in&lt;/b&gt;&lt;br&gt;nights = check_out − check_in (no +1). Only status = 'confirmed' bookings and blocked_dates count." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="560" height="60" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;One clause, rules.unavailable_exists(), used in four places&lt;/b&gt;&lt;br&gt;• GET /listings search: NOT EXISTS correlated on Listing.id (one SQL query)&lt;br&gt;• GET /listings/{id}/quote: is_available() → 409&lt;br&gt;• POST /bookings: is_available() inside _booking_lock → 409&lt;br&gt;• POST /listings/{id}/blocks: a block can't overlap a booking or block → 409&lt;br&gt;Frontend: RangeCalendar disables start … end−1 of each range from GET /availability." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="530" width="560" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7 · Pricing (quote)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Pricing: rules.quote(listing, check_in, check_out)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="One function prices the listing page, the search cards and checkout. POST /bookings recomputes it and stores a snapshot on the booking." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. nights&lt;/b&gt;&lt;br&gt;check_out − check_in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c5" value="7 nights&lt;br&gt;(Mon → next Mon)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;2. nightly_total&lt;/b&gt;&lt;br&gt;sum of nightly_rate():&lt;br&gt;Fri/Sat → weekend_price&lt;br&gt;(if set), else base_price" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c8" value="5 × ₹1,000 + 2 × ₹2,000&lt;br&gt;= ₹9,000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;3. discount&lt;/b&gt;&lt;br&gt;≥ 28 nights → monthly %&lt;br&gt;else ≥ 7 → weekly %&lt;br&gt;round(total × % / 100)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c12" value="weekly 10%&lt;br&gt;= ₹900" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;4. cleaning_fee&lt;/b&gt;&lt;br&gt;listing.cleaning_fee&lt;br&gt;(flat, per stay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c16" value="₹500" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;5. service_fee&lt;/b&gt;&lt;br&gt;round((nightly_total −&lt;br&gt;discount + cleaning) × 14%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c20" value="round(8,600 × 0.14)&lt;br&gt;= ₹1,204" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;6. total&lt;/b&gt;&lt;br&gt;nightly_total − discount&lt;br&gt;+ cleaning + service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="c24" value="9,000 − 900 + 500&lt;br&gt;+ 1,204 = &lt;b&gt;₹9,804&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="Example values are from test_pricing_weekend_discount_fees (base ₹1,000, weekend ₹2,000, cleaning ₹500, weekly 10%)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="600" height="24" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Callers&lt;/b&gt;&lt;br&gt;• GET /listings/{id}/quote → BookingCard and Checkout show these lines&lt;br&gt;• GET /listings with dates → stay_total on every card&lt;br&gt;• POST /bookings → price_snapshot() stores nights, nightly_total,&lt;br&gt;&amp;nbsp;&amp;nbsp;discount, cleaning_fee, service_fee, total on the booking row" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="560" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Why it's built this way&lt;/b&gt;&lt;br&gt;• The browser never sends a price, so it can't be tampered with&lt;br&gt;• The number shown always equals the number charged&lt;br&gt;• The snapshot keeps old bookings unchanged when the host edits prices&lt;br&gt;• Money is whole rupees (INTEGER): no float rounding errors" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="370" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8 · Booking lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Booking lifecycle (state machine)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="The database stores only status ∈ {confirmed, cancelled}. Upcoming / in stay / completed come from today's date; reviewed means a reviews row exists." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="26" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Upcoming&lt;/b&gt;&lt;br&gt;status = confirmed&lt;br&gt;today &amp;lt; check_in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="160" width="180" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;In stay&lt;/b&gt;&lt;br&gt;check_in ≤ today &amp;lt; check_out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="180" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Completed&lt;/b&gt;&lt;br&gt;check_out ≤ today" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="840" y="160" width="180" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Reviewed&lt;/b&gt;&lt;br&gt;reviews row exists&lt;br&gt;(UNIQUE booking_id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1170" y="160" width="180" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Cancelled&lt;/b&gt;&lt;br&gt;status = cancelled&lt;br&gt;dates free again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="180" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1245" y="300" width="30" height="30" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="255" y="520" width="30" height="30" as="geometry"/></mxCell><mxCell id="c12" value="POST /bookings&lt;br&gt;(201)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="check_in date&lt;br&gt;arrives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="check_out date&lt;br&gt;arrives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="POST /review&lt;br&gt;guest, once" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="POST /cancel&lt;br&gt;guest or host,&lt;br&gt;before check-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;What each state allows&lt;/b&gt; (enforced in routers/bookings.py and listings.py)&lt;br&gt;• Cancel: only Upcoming (check_in &amp;gt; today) → 400 otherwise · 403 if not the guest or the listing's host&lt;br&gt;• Review: only Completed, confirmed, by the guest, once → 400 / 403 / 409&lt;br&gt;• Messages: shown only for confirmed bookings and only when send_at ≤ now&lt;br&gt;• Host can't delete a listing while any confirmed booking has check_out &amp;gt; today → 409&lt;br&gt;• Overlap checks count only confirmed bookings, so cancelling frees the dates immediately" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="800" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="9 · Scheduled messages"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Scheduled host messages without a background job" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="rules.render_messages() fills each template when the booking is made and stores send_at. The API only returns messages whose send_at has passed (not to scale)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="200" as="sourcePoint"/><mxPoint x="1200" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="134" y="194" width="12" height="12" as="geometry"/></mxCell><mxCell id="c6" value="Booking created&lt;br&gt;(now)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="160" height="44" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="614" y="194" width="12" height="12" as="geometry"/></mxCell><mxCell id="c8" value="Day before check-in&lt;br&gt;09:00" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="160" height="44" as="geometry"/></mxCell><mxCell id="c9" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="774" y="194" width="12" height="12" as="geometry"/></mxCell><mxCell id="c10" value="Check-in day&lt;br&gt;(check_in_time)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="160" height="44" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1054" y="194" width="12" height="12" as="geometry"/></mxCell><mxCell id="c12" value="Checkout day&lt;br&gt;09:00" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="140" width="160" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;on_confirm&lt;/b&gt;&lt;br&gt;send_at = now&lt;br&gt;e.g. Wi-Fi details" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="76" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;day_before_checkin&lt;/b&gt;&lt;br&gt;send_at = check_in − 1 day, 09:00&lt;br&gt;e.g. directions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="200" height="76" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;on_checkout&lt;/b&gt;&lt;br&gt;send_at = check_out, 09:00&lt;br&gt;e.g. checkout steps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="250" width="200" height="76" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" target="c13"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="206" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" target="c14"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="206" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;endArrow=none;" edge="1" parent="1" target="c15"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="206" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="c19" value='&lt;b&gt;Last-minute rule&lt;/b&gt; (_send_at)&lt;br&gt;send_at = max(scheduled time, now + 1 second)&lt;br&gt;A booking made for tonight still gets its "day before" message, right after the confirmation and in the right order. Tested in test_last_minute_booking_orders_messages_after_confirmation.' style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="540" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Delivery = a filter, not a job&lt;/b&gt;&lt;br&gt;GET /bookings/{id}/messages and GET /bookings/inbox return only rows WHERE send_at ≤ now() for confirmed bookings. Time passing is what delivers a message. No cron, Celery or worker." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="370" width="560" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Placeholders filled at booking time:&lt;/b&gt;  {guest_name} · {host_name} · {listing_title} · {check_in} · {check_out} · {check_in_time} · {check_out_time} · {address} · {maps_link}.  Editing a template later doesn't change messages already rendered." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="1140" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10 · Frontend"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Frontend architecture (frontend/)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="32" as="geometry"/></mxCell><mxCell id="c3" value="Next.js App Router; every page is a client component that calls the API through lib/. Search state lives in the URL query string." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;app/layout.tsx&lt;/b&gt;  (root, wraps every route)&lt;br&gt;UserProvider (GET /me, /wishlist/ids) · Header + SearchBar · MobileNav · LoginModal (GET /users) · Toaster (sonner) · Airbnb Cereal via next/font/local" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#c6dbf5;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1180" height="54" as="geometry"/></mxCell><mxCell id="c5" value="Guest routes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#f7f9fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;/&lt;/b&gt;  Explore (page.tsx)&lt;br&gt;GET /listings?…&amp;amp;page&amp;amp;page_size=20&lt;br&gt;HomeRows: GET /listings?location=…" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c5"><mxGeometry x="15" y="34" width="350" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;/rooms/[id]&lt;/b&gt;&lt;br&gt;GET /listings/{id} · /availability · /reviews&lt;br&gt;BookingCard: GET /listings/{id}/quote" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c5"><mxGeometry x="15" y="108" width="350" height="66" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;/book/[id]&lt;/b&gt;  checkout&lt;br&gt;GET /listings/{id} · /quote · POST /bookings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="c5"><mxGeometry x="15" y="182" width="350" height="66" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;/trips&lt;/b&gt; · &lt;b&gt;/trips/[id]&lt;/b&gt;&lt;br&gt;GET /bookings/me · /bookings/{id} · /messages&lt;br&gt;POST /bookings/{id}/canc